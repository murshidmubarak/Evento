{
  "name": "eventops-backend",
  "version": "1.0.0",
  "description": "EventOps ERP – Backend API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "tsx --import ./tests/setup.ts --test --test-concurrency=1 tests/**/*.test.ts",
    "worker": "tsx src/workers/worker.ts",
    "worker:prod": "node dist/workers/worker.js",
    "worker:payment": "tsx src/workers/paymentReminderWorker.ts",
    "worker:payment:prod": "node dist/workers/paymentReminderWorker.js",
    "worker:selection": "tsx src/workers/workerSelectionWorker.ts",
    "worker:selection:prod": "node dist/workers/workerSelectionWorker.js",
    "worker:notification": "tsx src/workers/notificationWorker.ts",
    "worker:notification:prod": "node dist/workers/notificationWorker.js",
    "seed": "tsx seed.ts",
    "admin:create": "tsx src/scripts/createAdmin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.15",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.4.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5"
  }
}
