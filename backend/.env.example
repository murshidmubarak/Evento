PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/eventops
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
PASSWORD_RESET_EXPIRES_IN_MINS=15

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Frontend Application URL (for Payment Link callbacks)
FRONTEND_URL=http://localhost:5173

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Email Configuration
EMAIL_PROVIDER_API_KEY=your_email_provider_api_key_here
EMAIL_FROM=noreply@example.com
EMAIL_VERIFICATION_OTP_TTL_MINUTES=15
EMAIL_VERIFICATION_OTP_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_OTP_RESEND_COOLDOWN_SECONDS=60
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user_email_here
SMTP_PASS=your_smtp_app_password_here

# Payment Reminder Scheduler (Optional, default 1h / true)
REMINDER_CHECK_INTERVAL_MS=3600000
ENABLE_REMINDER_SCHEDULER=true

